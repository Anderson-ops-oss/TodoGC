[gc]
mode = "normal"
recent_days = 30
max_consecutive_skips = 5
restore_grace_days = 7

[heap]
max = 50

[notify]
ntfy_enabled = false
ntfy_server = "https://ntfy.sh"
ntfy_topic = ""
# ntfy_token = ""          # 受保护 topic 才需要；建议走 TODOGC_NTFY_TOKEN 环境变量，别把密钥提交进这份文件

[watch]
poll_seconds = 1800        # 轮询间隔(秒)：多久算一次判活，只算不一定推
digest_seconds = 86400     # 心跳摘要间隔(秒)：没有新事件也定期报个平安
remind_days = 7            # 候选状态没变时，隔多少天再提醒一次(别提醒一次就没下文)
heap_threshold_pct = 80    # 堆占用告警阈值(%)，跨过这条线才告警一次(边沿触发，不是持续刷屏)
lock_stale_seconds = 300   # 单实例锁心跳过期时间：判定上一个 watcher 已经死了、允许接管
